#version 460

#extension GL_EXT_samplerless_texture_functions : enable

#include "../common.glsl"
#include "../bindings.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float PI = 3.14159265359;
const float HALF_PI = 1.57079632679;

const int SLICE_COUNT = 2;
const int STEP_COUNT = 6;
const float SAMPLE_DISTRIBUTION_POWER = 2.0;
const float PIXEL_TOO_CLOSE = 1.3;
const float GOLDEN_RATIO = 0.6180339887498948482;

float load_view_z(ivec2 pixel, ivec2 size, MainCamera camera) {
    vec2 uv = (vec2(clamp(pixel, ivec2(0), size - 1)) + 0.5) / vec2(size);
    float depth = texture(sampler2D(graph_textures[push_constants.depth_descriptor_id], samplers[SAMPLER_NEAREST_CLAMP]), uv).r;
    return (camera.near * camera.far) / (camera.near + depth * (camera.far - camera.near));
}

vec3 view_position(ivec2 pixel, float view_z, ivec2 size, MainCamera camera) {
    vec2 uv = (vec2(clamp(pixel, ivec2(0), size - 1)) + 0.5) / vec2(size);
    vec2 view_xy = (uv * camera.ndc_to_view_mul + camera.ndc_to_view_add) * view_z;
    return vec3(view_xy, -view_z);
}

const uint HILBERT_WIDTH = 64u;

uint hilbert_index(uint pos_x, uint pos_y) {
    uint index = 0u;
    for (uint level = HILBERT_WIDTH / 2u; level > 0u; level /= 2u) {
        uint region_x = uint((pos_x & level) > 0u);
        uint region_y = uint((pos_y & level) > 0u);
        index += level * level * ((3u * region_x) ^ region_y);
        if (region_y == 0u) {
            if (region_x == 1u) {
                pos_x = (HILBERT_WIDTH - 1u) - pos_x;
                pos_y = (HILBERT_WIDTH - 1u) - pos_y;
            }
            uint temp = pos_x;
            pos_x = pos_y;
            pos_y = temp;
        }
    }
    return index;
}

vec2 spatiotemporal_noise(uvec2 pixel, uint temporal_index) {
    uint index = hilbert_index(pixel.x % HILBERT_WIDTH, pixel.y % HILBERT_WIDTH);
    index += 288u * (temporal_index % 64u);
    return fract(vec2(0.5) + float(index) * vec2(0.75487766624669276005, 0.5698402909980532659114));
}

float fast_acos(float x) {
    float abs_x = abs(x);
    float res = -0.156583 * abs_x + HALF_PI;
    res *= sqrt(1.0 - abs_x);
    return x >= 0.0 ? res : PI - res;
}

void main() {
    ivec2 size = ivec2(push_constants.width, push_constants.height);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    MainCamera camera = SceneBuffer(push_constants.scene_buffer_device_address).data.main_camera;

    float center_z = load_view_z(coord, size, camera);

    if (center_z >= camera.far * 0.999) {
        imageStore(storage_images_rg16f[push_constants.gtao_storage_id], coord, vec4(1.0, 1.0, 0.0, 0.0));
        return;
    }

    vec3 position = view_position(coord, center_z, size, camera);
    vec3 view = normalize(-position);

    vec2 center_uv = (vec2(coord) + 0.5) / vec2(size);
    vec3 world_normal = normalize(texture(sampler2D(graph_textures[push_constants.normal_descriptor_id], samplers[SAMPLER_NEAREST_CLAMP]), center_uv).xyz);
    vec3 normal = normalize(mat3(camera.view) * world_normal);

    float tan_half_fov_y = -camera.ndc_to_view_mul.y * 0.5;
    float focal_y = 1.0 / tan_half_fov_y;
    float pixel_radius = push_constants.radius * focal_y / (2.0 * center_z) * float(size.y);
    pixel_radius = clamp(pixel_radius, float(STEP_COUNT), 0.2 * float(size.y));

    vec2 noise = spatiotemporal_noise(uvec2(coord), push_constants.temporal_index);

    float nearest_occluder = push_constants.radius;
    float visibility = 0.0;

    for (int slice = 0; slice < SLICE_COUNT; slice++) {
        float phi = PI * (float(slice) + noise.x) / float(SLICE_COUNT);
        vec2 omega = vec2(cos(phi), -sin(phi));

        vec3 direction = vec3(cos(phi), sin(phi), 0.0);
        vec3 axis_raw = cross(direction, view);
        float axis_length = length(axis_raw);
        if (axis_length < 1e-4) {
            continue;
        }
        vec3 axis = axis_raw / axis_length;

        vec3 ortho_direction = direction - dot(direction, view) * view;
        vec3 projected_normal = normal - axis * dot(normal, axis);
        float projected_normal_length = length(projected_normal);
        if (projected_normal_length < 1e-4) {
            continue;
        }

        float sign_n = sign(dot(ortho_direction, projected_normal));
        float cos_n = clamp(dot(projected_normal, view) / projected_normal_length, 0.0, 1.0);
        float angle_n = sign_n * fast_acos(cos_n);

        float horizon_cos_plus = -1.0;
        float horizon_cos_minus = -1.0;

        for (int side = 0; side < 2; side++) {
            float side_sign = side == 0 ? -1.0 : 1.0;
            float horizon_cos = -1.0;

            for (int step = 0; step < STEP_COUNT; step++) {
                float step_noise = fract(noise.y + float(slice + step * STEP_COUNT) * GOLDEN_RATIO);
                float t = (float(step) + step_noise) / float(STEP_COUNT);
                t = pow(t, SAMPLE_DISTRIBUTION_POWER);
                float march_pixels = pixel_radius * t + PIXEL_TOO_CLOSE;
                ivec2 sample_pixel = coord + ivec2(round(side_sign * omega * march_pixels));

                float sample_z = load_view_z(sample_pixel, size, camera);
                vec3 sample_position = view_position(sample_pixel, sample_z, size, camera);

                vec3 delta = sample_position - position;
                float distance = length(delta);
                if (distance < 1e-4) {
                    continue;
                }

                float height = dot(delta, normal);
                if (height > 0.03 * distance && distance < push_constants.radius) {
                    nearest_occluder = min(nearest_occluder, distance);
                }

                vec3 sample_dir = delta / distance;
                float cos_horizon = dot(sample_dir, view);
                float falloff = 1.0 - smoothstep(0.5 * push_constants.radius, push_constants.radius, distance);
                float weighted = mix(-1.0, cos_horizon, falloff);

                horizon_cos = max(horizon_cos, weighted);
            }

            if (side == 0) {
                horizon_cos_minus = horizon_cos;
            } else {
                horizon_cos_plus = horizon_cos;
            }
        }

        float horizon_high = fast_acos(clamp(horizon_cos_plus, -1.0, 1.0));
        float horizon_low = -fast_acos(clamp(horizon_cos_minus, -1.0, 1.0));
        horizon_low = angle_n + max(horizon_low - angle_n, -HALF_PI);
        horizon_high = angle_n + min(horizon_high - angle_n, HALF_PI);

        float arc =
            0.25 * (-cos(2.0 * horizon_low - angle_n) + cos_n + 2.0 * horizon_low * sin(angle_n)) +
            0.25 * (-cos(2.0 * horizon_high - angle_n) + cos_n + 2.0 * horizon_high * sin(angle_n));

        visibility += projected_normal_length * arc;
    }

    visibility = clamp(visibility / float(SLICE_COUNT), 0.0, 1.0);
    visibility = pow(visibility, push_constants.power);

    float occluder_distance = clamp(nearest_occluder / push_constants.radius, 0.0, 1.0);

    imageStore(storage_images_rg16f[push_constants.gtao_storage_id], coord, vec4(visibility, occluder_distance, 0.0, 0.0));
}
