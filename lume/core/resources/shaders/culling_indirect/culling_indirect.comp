#version 460

#include "../common.glsl"
#include "push_constants.glsl"

layout(local_size_x = 256) in;

bool is_visible(vec4 frustum_planes[6], vec3 bounds_min, vec3 bounds_max) {
    for (int i = 0; i < 6; i++) {
        vec3 normal = frustum_planes[i].xyz;
        float distance = frustum_planes[i].w;

        vec3 point;
        point.x = (normal.x >= 0) ? bounds_max.x : bounds_min.x;
        point.y = (normal.y >= 0) ? bounds_max.y : bounds_min.y;
        point.z = (normal.z >= 0) ? bounds_max.z : bounds_min.z;

        if (dot(normal, point) + distance < 0) {
            return false;
        }
    }
    return true;
}

void append_draw(Submesh submesh, uint entity_index, uint submesh_index, uint cascade_mask) {
    IndirectBuffer indirect = IndirectBuffer(push_constants.indirect_buffer_device_address);
    DrawCountBuffer draw_count = DrawCountBuffer(push_constants.draw_count_buffer_device_address);
    DrawDataBuffer draw_data = DrawDataBuffer(push_constants.draw_data_buffer_device_address);

    uint current_command = atomicAdd(draw_count.value, 1);
    uint command_offset = current_command * 5;

    indirect.commands[command_offset + 0] = submesh.index_count;
    indirect.commands[command_offset + 1] = 1;
    indirect.commands[command_offset + 2] = submesh.index_offset;
    indirect.commands[command_offset + 3] = submesh.vertex_offset;
    indirect.commands[command_offset + 4] = current_command;

    draw_data.data[current_command].entity_index = entity_index;
    draw_data.data[current_command].submesh_index = submesh_index;
    draw_data.data[current_command].cascade_mask = cascade_mask;
}

void main() {
    uint entity_index = gl_GlobalInvocationID.x;
    if (entity_index >= push_constants.entity_count) return;

    SubmeshBuffer submeshes = SubmeshBuffer(push_constants.submesh_buffer_device_address);

    Entity entity = EntityBuffer(push_constants.entity_buffer_device_address).data[entity_index];
    Mesh mesh = MeshBuffer(push_constants.mesh_buffer_device_address).data[entity.mesh_index];

    CullingViewsBuffer culling_views = CullingViewsBuffer(push_constants.culling_views_buffer_device_address);

    CullingIndirectMetaStatisticsBuffer statistics = CullingIndirectMetaStatisticsBuffer(push_constants.meta_statistics_buffer_device_address);

    for (uint local_submesh_index = 0; local_submesh_index < mesh.submesh_count; local_submesh_index++) {
        uint submesh_index = mesh.submesh_offset + local_submesh_index;
        Submesh submesh = submeshes.data[submesh_index];

        vec3 local_center = (submesh.bounds_min.xyz + submesh.bounds_max.xyz) * 0.5;
        vec3 local_extents = (submesh.bounds_max.xyz - submesh.bounds_min.xyz) * 0.5;

        vec3 world_center = (entity.transform_matrix * vec4(local_center, 1.0)).xyz;

        mat3 abs_mesh_matrix = mat3(
            abs(entity.transform_matrix[0].xyz),
            abs(entity.transform_matrix[1].xyz),
            abs(entity.transform_matrix[2].xyz)
        );
        vec3 world_extents = abs_mesh_matrix * local_extents;

        vec3 world_min = world_center - world_extents;
        vec3 world_max = world_center + world_extents;

        if (push_constants.combine_views == 0u) {
            for (uint i = 0; i < push_constants.view_count; i++) {
                CullingView culling_view = culling_views.data[i];

                if (is_visible(culling_view.frustum_planes, world_min, world_max)) {
                    append_draw(submesh, entity_index, submesh_index, 1u);

                    atomicAdd(statistics.data[i].submeshes_rendered, 1);
                } else {
                    atomicAdd(statistics.data[i].submeshes_culled, 1);
                }
            }
        } else {
            uint cascade_mask = 0u;
            for (uint i = 0; i < push_constants.view_count; i++) {
                CullingView culling_view = culling_views.data[i];

                if (is_visible(culling_view.frustum_planes, world_min, world_max)) {
                    cascade_mask |= (1u << i);
                }
            }

            if (cascade_mask != 0u) {
                append_draw(submesh, entity_index, submesh_index, cascade_mask);

                atomicAdd(statistics.data[0].submeshes_rendered, 1);
            } else {
                atomicAdd(statistics.data[0].submeshes_culled, 1);
            }
        }
    }
}
