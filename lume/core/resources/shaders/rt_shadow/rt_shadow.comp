#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : enable

#include "../common.glsl"
#include "../bindings.glsl"
#include "../projection.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(set = GLOBAL_SET, binding = BINDING_ACCELERATION_STRUCTURE) uniform accelerationStructureEXT scene_tlas[];

layout(local_size_x = 16, local_size_y = 16) in;

const float RAY_TMIN = 0.01;
const float RAY_TMAX = 10000.0;

bool trace_occluded(vec3 origin, vec3 direction) {
    rayQueryEXT ray_query;
    rayQueryInitializeEXT(
        ray_query,
        scene_tlas[push_constants.tlas_descriptor_id],
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        RT_INSTANCE_MASK_OPAQUE,
        origin,
        RAY_TMIN,
        direction,
        RAY_TMAX
    );
    rayQueryProceedEXT(ray_query);
    return rayQueryGetIntersectionTypeEXT(ray_query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storage_images_r16f[push_constants.visibility_storage_id]);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    float depth = texelFetch(graph_textures[push_constants.depth_descriptor_id], coord, 0).r;

    float visibility = 1.0;
    if (depth > 0.0) {
        vec3 normal = normalize(texelFetch(graph_textures[push_constants.normal_descriptor_id], coord, 0).xyz);
        Scene scene = SceneBuffer(push_constants.scene_buffer_device_address).data;

        vec3 to_sun = normalize(-scene.light_direction);

        if (dot(normal, to_sun) <= 0.0) {
            visibility = 0.0;
        } else {
            vec3 world_position = world_position_from_depth(scene.main_camera.inverse_jittered_view_projection, coord, size, depth);

            uint samples = max(push_constants.sample_count, 1u);
            float lit = 0.0;
            for (uint i = 0u; i < samples; i++) {
                vec3 direction = sun_disk_direction(to_sun, push_constants.sun_angular_radius, coord, i, samples, push_constants.frame_number);

                if (!trace_occluded(world_position, direction)) {
                    lit += 1.0;
                }
            }
            visibility = lit / float(samples);
        }
    }

    imageStore(storage_images_r16f[push_constants.visibility_storage_id], coord, vec4(visibility, 0.0, 0.0, 0.0));
}
