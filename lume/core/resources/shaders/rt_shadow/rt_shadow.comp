#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : enable

#include "../bindings.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(set = GLOBAL_SET, binding = BINDING_ACCELERATION_STRUCTURE) uniform accelerationStructureEXT scene_tlas[];

layout(local_size_x = 16, local_size_y = 16) in;

const float RAY_TMAX = 10000.0;

bool trace_occluded(vec3 origin, vec3 direction) {
    rayQueryEXT ray_query;
    rayQueryInitializeEXT(
        ray_query,
        scene_tlas[push_constants.tlas_descriptor_id],
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xFF,
        origin,
        0.01,
        direction,
        RAY_TMAX
    );
    rayQueryProceedEXT(ray_query);
    return rayQueryGetIntersectionTypeEXT(ray_query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(push_constants.width), int(push_constants.height));
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    float depth = texelFetch(graph_textures[push_constants.depth_descriptor_id], coord, 0).r;

    float visibility = 1.0;
    if (depth > 0.0) {
        vec3 normal = normalize(texelFetch(graph_textures[push_constants.normal_descriptor_id], coord, 0).xyz);
        vec3 to_sun = normalize(push_constants.sun_direction.xyz);

        if (dot(normal, to_sun) <= 0.0) {
            visibility = 0.0;
        } else {
            vec2 uv = (vec2(coord) + 0.5) / vec2(size);
            vec2 ndc = uv * 2.0 - 1.0;

            vec4 world_homogeneous = push_constants.inverse_view_projection * vec4(ndc, depth, 1.0);
            vec3 world_position = world_homogeneous.xyz / world_homogeneous.w;

            vec3 up = abs(to_sun.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            vec3 tangent = normalize(cross(up, to_sun));
            vec3 bitangent = cross(to_sun, tangent);

            float disk_radius = tan(push_constants.sun_angular_radius);

            uint samples = max(push_constants.sample_count, 1u);
            float lit = 0.0;
            for (uint i = 0u; i < samples; i++) {
                uint pixel_hash = uint(coord.x) * 0x9e3779b9u ^ uint(coord.y) * 0x85ebca6bu ^ uint(i) * 0xc2b2ae35u ^ push_constants.frame_number * 0x27d4eb2fu;
                float seed = float(i) + hash_unit(pixel_hash);
                vec2 disk = vogelDiskSample(disk_radius, int(samples), seed);
                vec3 direction = normalize(to_sun + disk.x * tangent + disk.y * bitangent);
                if (!trace_occluded(world_position, direction)) {
                    lit += 1.0;
                }
            }
            visibility = lit / float(samples);
        }
    }

    imageStore(storage_images_rgba16f[push_constants.visibility_storage_id], coord, vec4(vec3(visibility), 0.0));
}
