#version 460
#extension GL_EXT_samplerless_texture_functions : enable

#include "../bindings.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

vec3 rgb_to_ycocg(vec3 c) {
    return vec3(
        0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
        0.5 * c.r - 0.5 * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 ycocg_to_rgb(vec3 c) {
    return vec3(
        c.x + c.y - c.z,
        c.x + c.z,
        c.x - c.y - c.z
    );
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push_constants.display_width) || coord.y >= int(push_constants.display_height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(float(push_constants.display_width), float(push_constants.display_height));

    vec3 scene = texture(
        sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        uv
    ).rgb;

    if (push_constants.history_valid == 0u) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 0.0));
        return;
    }

    vec2 motion = texture(
        sampler2D(graph_textures[push_constants.velocity_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        uv
    ).rg;

    vec2 history_uv = uv + motion;

    bool on_screen = all(greaterThanEqual(history_uv, vec2(0.0))) && all(lessThanEqual(history_uv, vec2(1.0)));
    if (!on_screen) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 0.0));
        return;
    }

    ivec2 scene_size = textureSize(graph_textures[push_constants.scene_color_texture], 0);
    vec2 texel = 1.0 / vec2(scene_size);

    vec3 scene_ycocg = rgb_to_ycocg(scene);
    vec3 moment_1 = scene_ycocg;
    vec3 moment_2 = scene_ycocg * scene_ycocg;
    float neighbour_min = scene_ycocg.x;
    float neighbour_max = scene_ycocg.x;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) {
                continue;
            }

            vec3 neighbour = rgb_to_ycocg(texture(
                sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
                uv + vec2(x, y) * texel
            ).rgb);

            moment_1 += neighbour;
            moment_2 += neighbour * neighbour;
            neighbour_min = min(neighbour_min, neighbour.x);
            neighbour_max = max(neighbour_max, neighbour.x);
        }
    }

    vec3 mean = moment_1 / 9.0;
    vec3 deviation = sqrt(max(moment_2 / 9.0 - mean * mean, vec3(0.0)));
    vec3 box_min = mean - deviation;
    vec3 box_max = mean + deviation;

    float is_thin_feature = (scene_ycocg.x > neighbour_max || scene_ycocg.x < neighbour_min) ? 1.0 : 0.0;

    vec4 history_sample = texture(
        sampler2D(graph_textures[push_constants.history_prev_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        history_uv
    );

    float motion_blend = clamp(length(motion) * 32.0, 0.0, 0.85);

    float lock = max(is_thin_feature, history_sample.a * 0.9);
    lock *= 1.0 - motion_blend;

    vec3 widen = deviation * (lock * 3.0);
    vec3 history = ycocg_to_rgb(clamp(rgb_to_ycocg(history_sample.rgb), box_min - widen, box_max + widen));

    float blend = mix(max(0.1, motion_blend), 0.04, lock);

    vec3 result = mix(history, scene, blend);

    imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(result, lock));
}
