#version 460
#extension GL_EXT_samplerless_texture_functions : enable

#include "../bindings.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

vec3 rgb_to_ycocg(vec3 c) {
    return vec3(
        0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
        0.5 * c.r - 0.5 * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 ycocg_to_rgb(vec3 c) {
    return vec3(
        c.x + c.y - c.z,
        c.x + c.z,
        c.x - c.y - c.z
    );
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push_constants.display_width) || coord.y >= int(push_constants.display_height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(float(push_constants.display_width), float(push_constants.display_height));

    vec3 scene = texture(
        sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        uv
    ).rgb;

    if (push_constants.history_valid == 0u) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 1.0));
        return;
    }

    ivec2 velocity_size = textureSize(graph_textures[push_constants.velocity_texture], 0);
    vec2 velocity_texel = 1.0 / vec2(velocity_size);

    float nearest_depth = 2.0;
    vec2 motion = vec2(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 tap_uv = uv + vec2(dx, dy) * velocity_texel;

            float tap_depth = texture(
                sampler2D(graph_textures[push_constants.depth_texture], samplers[SAMPLER_NEAREST_CLAMP]),
                tap_uv
            ).r;

            if (tap_depth < nearest_depth) {
                nearest_depth = tap_depth;
                motion = texture(
                    sampler2D(graph_textures[push_constants.velocity_texture], samplers[SAMPLER_NEAREST_CLAMP]),
                    tap_uv
                ).rg;
            }
        }
    }

    vec2 history_uv = uv + motion;

    bool on_screen = all(greaterThanEqual(history_uv, vec2(0.0))) && all(lessThanEqual(history_uv, vec2(1.0)));
    if (!on_screen) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 1.0));
        return;
    }

    ivec2 scene_size = textureSize(graph_textures[push_constants.scene_color_texture], 0);
    vec2 texel = 1.0 / vec2(scene_size);

    vec3 moment_1 = vec3(0.0);
    vec3 moment_2 = vec3(0.0);
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 neighbour = rgb_to_ycocg(texture(
                sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
                uv + vec2(x, y) * texel
            ).rgb);

            moment_1 += neighbour;
            moment_2 += neighbour * neighbour;
        }
    }

    vec3 mean = moment_1 / 9.0;
    vec3 deviation = sqrt(max(moment_2 / 9.0 - mean * mean, vec3(0.0)));
    vec3 box_min = mean - deviation;
    vec3 box_max = mean + deviation;

    vec3 history = texture(
        sampler2D(graph_textures[push_constants.history_prev_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        history_uv
    ).rgb;

    history = ycocg_to_rgb(clamp(rgb_to_ycocg(history), box_min, box_max));

    float motion_blend = clamp(length(motion) * 32.0, 0.0, 0.85);
    float blend = max(0.1, motion_blend);

    vec3 result = mix(history, scene, blend);

    imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(result, 1.0));
}
