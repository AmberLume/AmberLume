#version 460
#extension GL_EXT_samplerless_texture_functions : enable

#include "../bindings.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const float MOTION_EPSILON_PIXELS = 0.1;
const float MOTION_BLEND_PIXELS = 32.0;
const float ACCUMULATION_FRAMES_STILL = 10.0;
const float ACCUMULATION_FRAMES_MOVING = 1.2;

vec3 rgb_to_ycocg(vec3 c) {
    return vec3(
        0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
        0.5 * c.r - 0.5 * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b
    );
}

vec3 tonemap(vec3 color) {
    return color / (1.0 + max(max(color.r, color.g), color.b));
}

vec3 inverse_tonemap(vec3 color) {
    return color / max(1.0 - max(max(color.r, color.g), color.b), 1e-3);
}

vec3 ycocg_to_rgb(vec3 c) {
    return vec3(
        c.x + c.y - c.z,
        c.x + c.z,
        c.x - c.y - c.z
    );
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push_constants.display_width) || coord.y >= int(push_constants.display_height)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(float(push_constants.display_width), float(push_constants.display_height));

    vec3 scene = texture(
        sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        uv
    ).rgb;

    if (push_constants.history_valid == 0u) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 1.0));
        return;
    }

    vec2 display_size = vec2(float(push_constants.display_width), float(push_constants.display_height));

    vec2 motion = texture(
        sampler2D(graph_textures[push_constants.velocity_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        uv
    ).rg;

    float motion_pixels = length(motion * display_size);

    if (motion_pixels < MOTION_EPSILON_PIXELS) {
        motion = vec2(0.0);
        motion_pixels = 0.0;
    }

    vec2 history_uv = uv + motion;

    bool on_screen = all(greaterThanEqual(history_uv, vec2(0.0))) && all(lessThanEqual(history_uv, vec2(1.0)));
    if (!on_screen) {
        imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(scene, 1.0));
        return;
    }

    ivec2 scene_size = textureSize(graph_textures[push_constants.scene_color_texture], 0);
    vec2 texel = 1.0 / vec2(scene_size);

    vec3 scene_ycocg = rgb_to_ycocg(tonemap(scene));
    vec3 moment_1 = scene_ycocg;
    vec3 moment_2 = scene_ycocg * scene_ycocg;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) {
                continue;
            }

            vec3 neighbour = rgb_to_ycocg(tonemap(texture(
                sampler2D(graph_textures[push_constants.scene_color_texture], samplers[SAMPLER_LINEAR_CLAMP]),
                uv + vec2(x, y) * texel
            ).rgb));

            moment_1 += neighbour;
            moment_2 += neighbour * neighbour;
        }
    }

    vec3 mean = moment_1 / 9.0;
    vec3 deviation = sqrt(max(moment_2 / 9.0 - mean * mean, vec3(0.0)));

    vec4 history_sample = texture(
        sampler2D(graph_textures[push_constants.history_prev_texture], samplers[SAMPLER_LINEAR_CLAMP]),
        history_uv
    );

    vec3 history_ycocg = clamp(rgb_to_ycocg(tonemap(history_sample.rgb)), mean - deviation, mean + deviation);

    float motion_factor = clamp(motion_pixels / MOTION_BLEND_PIXELS, 0.0, 1.0);
    float accumulation_limit = mix(ACCUMULATION_FRAMES_STILL, ACCUMULATION_FRAMES_MOVING, motion_factor);
    float accumulation = min(history_sample.a + 1.0, accumulation_limit);

    vec3 result = inverse_tonemap(ycocg_to_rgb(mix(history_ycocg, scene_ycocg, 1.0 / accumulation)));

    imageStore(storage_images_rgba16f[push_constants.history_curr_storage], coord, vec4(result, accumulation));
}
