#version 460

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../bindings.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(buffer_reference, std430) buffer SdsmResult {
    uint farthest_depth_bits;
};

shared uint group_min;

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        group_min = floatBitsToUint(1.0);
    }
    barrier();

    uvec2 coord = gl_GlobalInvocationID.xy * push_constants.stride;
    float depth = 1.0;
    if (coord.x < push_constants.depth_width && coord.y < push_constants.depth_height) {
        float sampled = texelFetch(graph_textures[push_constants.depth_descriptor_id], ivec2(coord), 0).r;
        if (sampled > 0.0) {
            depth = sampled;
        }
    }

    atomicMin(group_min, floatBitsToUint(depth));
    barrier();

    if (gl_LocalInvocationIndex == 0u) {
        SdsmResult result = SdsmResult(push_constants.result_buffer_device_address);
        atomicMin(result.farthest_depth_bits, group_min);
    }
}
