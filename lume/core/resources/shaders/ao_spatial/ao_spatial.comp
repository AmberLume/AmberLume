#version 460

#extension GL_EXT_samplerless_texture_functions : enable

#include "../common.glsl"
#include "../bindings.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const int TAP_COUNT = 8;

vec3 world_position(mat4 inverse_view_projection, vec3 camera_position, vec2 uv, float linear_z) {
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 far_point = inverse_view_projection * vec4(ndc, 0.0, 1.0);
    vec3 direction = normalize(far_point.xyz / far_point.w - camera_position);

    return camera_position + direction * linear_z;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(push_constants.width), int(push_constants.height));

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec2 center = texelFetch(graph_textures[push_constants.noisy_descriptor_id], coord, 0).rg;
    vec4 guide = texelFetch(graph_textures[push_constants.guide_descriptor_id], coord, 0);

    float linear_z = guide.r;
    vec3 normal = guide.gba;

    float ao = center.r;
    float occluder_distance = center.g;

    if (linear_z > 0.0) {
        MainCamera camera = SceneBuffer(push_constants.scene_buffer_device_address).data.main_camera;

        vec2 uv = (vec2(coord) + 0.5) / vec2(size);
        vec3 position = world_position(camera.inverse_view_projection, camera.position, uv, linear_z);

        float frustum_size = abs(camera.ndc_to_view_mul.y) * linear_z;

        float total = center.r;
        float total_occluder = center.g;
        float total_weight = 1.0;

        for (int tap = 0; tap < TAP_COUNT; tap++) {
            vec2 offset = vogel_disk_sample(
                push_constants.blur_radius,
                TAP_COUNT,
                sample_seed(coord, uint(tap), push_constants.frame_number)
            );
            ivec2 tap_coord = clamp(coord + ivec2(round(offset)), ivec2(0), size - 1);

            if (tap_coord == coord) {
                continue;
            }

            vec4 tap_guide = texelFetch(graph_textures[push_constants.guide_descriptor_id], tap_coord, 0);

            if (tap_guide.r <= 0.0) {
                continue;
            }

            vec2 tap_uv = (vec2(tap_coord) + 0.5) / vec2(size);
            vec3 tap_position = world_position(camera.inverse_view_projection, camera.position, tap_uv, tap_guide.r);

            float plane_distance = abs(dot(normal, tap_position - position));
            float plane_weight = smoothstep(1.0, 0.0, plane_distance / (push_constants.plane_sensitivity * frustum_size));
            float normal_weight = max(0.0, (dot(tap_guide.gba, normal) - push_constants.normal_threshold) / (1.0 - push_constants.normal_threshold));

            float weight = plane_weight * normal_weight;

            if (weight <= 0.0) {
                continue;
            }

            vec2 tap_sample = texelFetch(graph_textures[push_constants.noisy_descriptor_id], tap_coord, 0).rg;

            total += weight * tap_sample.r;
            total_occluder += weight * tap_sample.g;
            total_weight += weight;
        }

        ao = total / total_weight;
        occluder_distance = total_occluder / total_weight;
    }

    imageStore(storage_images_rg16f[push_constants.ao_storage_id], coord, vec4(ao, occluder_distance, 0.0, 0.0));
}
