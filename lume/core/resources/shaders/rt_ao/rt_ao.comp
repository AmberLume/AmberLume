#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : enable

#include "../common.glsl"
#include "../bindings.glsl"
#include "../projection.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(set = GLOBAL_SET, binding = BINDING_ACCELERATION_STRUCTURE) uniform accelerationStructureEXT scene_tlas[];

layout(local_size_x = 16, local_size_y = 16) in;

bool trace_occluded(vec3 origin, vec3 direction, float max_distance) {
    rayQueryEXT ray_query;
    rayQueryInitializeEXT(
        ray_query,
        scene_tlas[push_constants.tlas_descriptor_id],
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        RT_INSTANCE_MASK_OPAQUE,
        origin,
        0.01,
        direction,
        max_distance
    );
    rayQueryProceedEXT(ray_query);
    return rayQueryGetIntersectionTypeEXT(ray_query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(push_constants.width), int(push_constants.height));
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    uint period = push_constants.trace_period;
    if (period > 1u && ao_trace_phase(coord, period) != push_constants.frame_number % period) {
        return;
    }

    float depth = texelFetch(graph_textures[push_constants.depth_descriptor_id], coord, 0).r;

    float ao = 1.0;
    if (depth > 0.0) {
        vec3 normal = normalize(texelFetch(graph_textures[push_constants.normal_descriptor_id], coord, 0).xyz);

        vec3 world_position = world_position_from_depth(push_constants.inverse_view_projection, coord, size, depth);

        uint samples = max(push_constants.sample_count, 1u);
        uint occluded = 0u;
        for (uint i = 0u; i < samples; i++) {
            vec3 direction = cosine_hemisphere_direction(normal, coord, i, samples, push_constants.frame_number);

            if (trace_occluded(world_position, direction, push_constants.ao_radius)) {
                occluded++;
            }
        }

        ao = 1.0 - float(occluded) / float(samples);
        ao = pow(ao, push_constants.ao_power);
    }

    imageStore(storage_images_rg16f[push_constants.ao_storage_id], coord, vec4(ao, 0.0, 0.0, 0.0));
}
