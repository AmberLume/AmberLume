#version 460

#extension GL_EXT_samplerless_texture_functions : enable

#include "../bindings.glsl"
#include "push_constants.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(push_constants.width) || coord.y >= int(push_constants.height)) {
        return;
    }

    float depth = texelFetch(graph_textures[push_constants.depth_descriptor_id], coord, 0).r;

    vec4 guide = vec4(0.0);
    if (depth > 0.0) {
        vec2 uv = (vec2(coord) + 0.5) / vec2(float(push_constants.width), float(push_constants.height));
        vec2 ndc = uv * 2.0 - 1.0;

        vec4 world_homogeneous = push_constants.inverse_view_projection * vec4(ndc, depth, 1.0);
        vec3 world_position = world_homogeneous.xyz / world_homogeneous.w;

        float linear_z = distance(world_position, push_constants.camera_position.xyz);
        vec3 normal = normalize(texelFetch(graph_textures[push_constants.normal_descriptor_id], coord, 0).xyz);

        guide = vec4(linear_z, normal);
    }

    imageStore(storage_images_rgba16f[push_constants.guide_storage_id], coord, guide);
}
