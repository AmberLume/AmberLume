#version 460

#include "../common.glsl"
#include "../mesh_vertex.glsl"
#include "push_constants.glsl"

layout(local_size_x = 256) in;

struct TerrainGenerateRequest {
    uint mesh_id;
    uint height_offset;
    float cell_size;
    uint _pad0;
};

layout(buffer_reference, std430) readonly buffer TerrainGenerateRequestBuffer {
    TerrainGenerateRequest data[];
};

layout(buffer_reference, std430) readonly buffer TerrainHeightBuffer {
    float data[];
};

layout(buffer_reference, std430) writeonly buffer TerrainVertexBuffer {
    VertexPosition data[];
};

layout(buffer_reference, std430) writeonly buffer TerrainNormalTangentBuffer {
    VertexNormalTangent data[];
};

uint window_index(uint height_offset, int column, int row) {
    int border = int(push_constants.window_stride - push_constants.nodes) / 2;
    int stride = int(push_constants.window_stride);

    return height_offset + uint((row + border) * stride + (column + border));
}

void main() {
    uint node_index = gl_GlobalInvocationID.x;

    if (node_index >= push_constants.node_count) {
        return;
    }

    uint nodes = push_constants.nodes;
    uint chunk_nodes = nodes * nodes;

    uint request_index = node_index / chunk_nodes;
    uint local_index = node_index % chunk_nodes;

    TerrainGenerateRequest request = TerrainGenerateRequestBuffer(push_constants.request_buffer_device_address).data[request_index];

    TerrainHeightBuffer heights = TerrainHeightBuffer(push_constants.height_buffer_device_address);

    int column = int(local_index % nodes);
    int row = int(local_index / nodes);

    float height = heights.data[window_index(request.height_offset, column, row)];
    float left = heights.data[window_index(request.height_offset, column - 1, row)];
    float right = heights.data[window_index(request.height_offset, column + 1, row)];
    float back = heights.data[window_index(request.height_offset, column, row - 1)];
    float front = heights.data[window_index(request.height_offset, column, row + 1)];

    float cell_size = request.cell_size;
    float half_size = float(nodes - 1u) * cell_size * 0.5;
    float span = 2.0 * cell_size;

    vec3 position = vec3(
        float(column) * cell_size - half_size,
        height,
        float(row) * cell_size - half_size
    );

    vec3 normal = normalize(vec3(left - right, span, back - front));
    vec3 tangent = normalize(vec3(span, right - left, 0.0));

    Mesh mesh = MeshBuffer(push_constants.mesh_buffer_device_address).data[request.mesh_id];
    Submesh submesh = SubmeshBuffer(push_constants.submesh_buffer_device_address).data[mesh.submesh_offset];

    TerrainVertexBuffer vertices = TerrainVertexBuffer(push_constants.vertex_position_buffer_device_address);
    TerrainNormalTangentBuffer normal_tangents = TerrainNormalTangentBuffer(push_constants.vertex_normal_tangent_buffer_device_address);

    uint vertex_index = submesh.vertex_offset + local_index;

    vertices.data[vertex_index].position[0] = position.x;
    vertices.data[vertex_index].position[1] = position.y;
    vertices.data[vertex_index].position[2] = position.z;

    normal_tangents.data[vertex_index].normal[0] = normal.x;
    normal_tangents.data[vertex_index].normal[1] = normal.y;
    normal_tangents.data[vertex_index].normal[2] = normal.z;

    normal_tangents.data[vertex_index].tangent[0] = tangent.x;
    normal_tangents.data[vertex_index].tangent[1] = tangent.y;
    normal_tangents.data[vertex_index].tangent[2] = tangent.z;
    normal_tangents.data[vertex_index].tangent[3] = 1.0;
}
