#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_samplerless_texture_functions : enable

#include "../common.glsl"
#include "../bindings.glsl"
#include "../projection.glsl"
#include "../sampling.glsl"
#include "push_constants.glsl"

layout(set = GLOBAL_SET, binding = BINDING_ACCELERATION_STRUCTURE) uniform accelerationStructureEXT scene_tlas[];

layout(local_size_x = 16, local_size_y = 16) in;

const float RAY_TMIN = 0.01;
const float RAY_TMAX = 10000.0;
const vec3 LUMINANCE_WEIGHTS = vec3(0.2126, 0.7152, 0.0722);

Material candidate_material(rayQueryEXT ray_query) {
    uint entity_index = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(ray_query, false));
    Entity entity = EntityBuffer(push_constants.entity_buffer_device_address).data[entity_index];
    Mesh mesh = MeshBuffer(push_constants.mesh_buffer_device_address).data[entity.mesh_index];

    uint submesh_index = mesh.submesh_offset
        + uint(rayQueryGetIntersectionGeometryIndexEXT(ray_query, false));
    Submesh submesh = SubmeshBuffer(push_constants.submesh_buffer_device_address).data[submesh_index];

    return MaterialBuffer(push_constants.material_buffer_device_address).data[submesh.material_index];
}

vec3 blend_transmittance(Material material) {
    vec4 base_color = material.base_color_factor;

    float max_channel = max(base_color.r, max(base_color.g, base_color.b));
    vec3 hue = max_channel > 0.0 ? base_color.rgb / max_channel : vec3(1.0);

    float hue_luminance = dot(hue, LUMINANCE_WEIGHTS);
    float saturation = hue_luminance < 1.0
        ? min(base_color.a / (1.0 - hue_luminance), 1.0)
        : 0.0;

    vec3 tint = mix(vec3(1.0), hue, saturation);

    return (1.0 - base_color.a) * tint / dot(tint, LUMINANCE_WEIGHTS);
}

vec3 trace_transmittance(vec3 origin, vec3 direction) {
    rayQueryEXT ray_query;
    rayQueryInitializeEXT(
        ray_query,
        scene_tlas[push_constants.tlas_descriptor_id],
        gl_RayFlagsNoOpaqueEXT,
        RT_INSTANCE_MASK_OPAQUE | RT_INSTANCE_MASK_BLEND,
        origin,
        RAY_TMIN,
        direction,
        RAY_TMAX
    );

    vec3 transmittance = vec3(1.0);

    while (rayQueryProceedEXT(ray_query)) {
        Material material = candidate_material(ray_query);

        if ((material.flags & MATERIAL_ALPHA_MODE_BITS) != MATERIAL_FLAG_ALPHA_BLEND) {
            rayQueryTerminateEXT(ray_query);

            return vec3(0.0);
        }

        if (!rayQueryGetIntersectionFrontFaceEXT(ray_query, false)) {
            continue;
        }

        transmittance *= blend_transmittance(material);
    }

    return transmittance;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storage_images_rgba16f[push_constants.transmittance_storage_id]);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    float depth = texelFetch(graph_textures[push_constants.depth_descriptor_id], coord, 0).r;

    vec3 transmittance = vec3(1.0);
    if (depth > 0.0) {
        vec3 normal = normalize(texelFetch(graph_textures[push_constants.normal_descriptor_id], coord, 0).xyz);
        vec3 to_sun = normalize(push_constants.sun_direction.xyz);

        if (dot(normal, to_sun) <= 0.0) {
            transmittance = vec3(0.0);
        } else {
            SceneBuffer scene = SceneBuffer(push_constants.scene_buffer_device_address);
            vec3 world_position = world_position_from_depth(
                inverse(scene.data.main_camera.jittered_view_projection), coord, size, depth);

            uint samples = max(push_constants.sample_count, 1u);
            vec3 transmitted = vec3(0.0);
            for (uint i = 0u; i < samples; i++) {
                vec3 direction = sun_disk_direction(to_sun, push_constants.sun_angular_radius, coord, i, samples, push_constants.frame_number);

                transmitted += trace_transmittance(world_position, direction);
            }
            transmittance = transmitted / float(samples);
        }
    }

    imageStore(storage_images_rgba16f[push_constants.transmittance_storage_id], coord, vec4(transmittance, 0.0));
}
